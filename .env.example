# Copy to .env and fill in only what you use. Never commit .env.

# Scholarly APIs (evidence layer)
CROSSREF_MAILTO=you@example.org      # puts requests in Crossref's polite pool
OPENALEX_API_KEY=                    # free key, required by OpenAlex since 2026
SEMANTIC_SCHOLAR_API_KEY=            # optional; unauthenticated access shares a global pool
EXA_API_KEY=                         # grey-literature and world-claim search

# Model providers (systems and judges)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
AWS_PROFILE=                         # for Bedrock-hosted judges
AWS_REGION=us-east-1
